#!/bin/bash
# omarchy:summary=Interactive picker for per-monitor and per-terminal settings
# omarchy:group=display
# omarchy:name=pick
# omarchy:args=[monitor <mode|scale|position|transform>|terminal]
# omarchy:examples=omarchy display pick monitor scale | omarchy display pick monitor position | omarchy display pick terminal

# Launches the Omarchy menu to choose a monitor/terminal and the value to apply,
# then calls `omarchy display monitor|terminal set` to apply it live + persist.

set -euo pipefail

# Resolve sibling scripts through this file's own location. `omarchy display
# ...` cannot be used here: the Omarchy dispatcher only globs the directory it
# is installed in, so scripts placed on PATH by a plugin are never discovered.
# readlink -f follows the symlink that install creates in ~/.local/bin back to
# the plugin's bin directory, so this works for both install paths and for a
# direct checkout.
BIN_DIR="$(cd -- "$(dirname -- "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

MON_ICON=$'\U000f0431'   # 󰀱 display
SCALE_ICON=$'\U000f0878' # 󰡸
POS_ICON=$'\U000f0a72'   # 󰩲
TF_ICON=$'\U000f013a'    # 󰄺
TERM_ICON=$'\U000f4898'  # 󱢘

pick() { omarchy-menu-select "$@"; }

TICK_CHAR="\u2713"
TICK=" $TICK_CHAR"

# Current value of one field for an output, straight from Hyprland.
current_field() {
  hyprctl monitors -j 2>/dev/null | jq -r --arg o "$1" --arg f "$2" '
    .[] | select(.name == $o) |
    if $f == "mode" then "\(.width)x\(.height)@\(.refreshRate)"
    elif $f == "scale" then (.scale | tostring)
    else (.transform | tostring) end' 2>/dev/null
}

# Append a tick to the entry that is already active, so each list shows what
# the monitor is running instead of a flat set of choices.
# Drop the tick (and the space before it) from a selection before it is used
# as a value.
strip_tick() { printf '%s' "${1%% $(printf '%b' "$TICK_CHAR")*}"; }

mark_current() { # <current> ; entries on stdin
  local cur="$1" line
  while IFS= read -r line; do
    if [[ "$line" == "$cur" ]]; then printf '%s%b\n' "$line" "$TICK"; else printf '%s\n' "$line"; fi
  done
}

list_monitors() {
  hyprctl monitors -j 2>/dev/null | jq -r '.[] | "\(.name)\t\(.width)x\(.height)@\(.refreshRate) scale \(.scale)"' 2>/dev/null
}

pick_monitor() {
  local sel
  sel="$(pick "$MON_ICON Display" $(list_monitors))" || return 1
  # Returned as "name\t subtext"; keep the name only.
  cut -f1 <<<"$sel"
}

# ---- monitor sub-pickers ----

pick_mode() {
  local out="$1"
  local modes
  # Hyprland publishes the mode list as `availableModes`, an array of
  # "WxH@R.RRHz" strings. Older builds exposed `modes` as objects, so fall back
  # to that shape rather than silently reporting a monitor with no modes.
  modes="$(hyprctl monitors -j | jq -r --arg o "$out" '.[] | select(.name==$o) | if (.availableModes | type) == "array" and (.availableModes | length) > 0 then .availableModes[] else (.modes[]? | "\(.width)x\(.height)@\(.refreshRate)") end' | sort -u -V)"
  [[ -n $modes ]] || { echo "No modes reported for $out" >&2; return 1; }
  # hyprctl reports the live rate at full precision ("184.99800") while the
  # mode list is rounded ("185.00Hz"), so match on the dimensions plus the
  # rate truncated to the list's two decimals.
  local cur cur_norm
  cur="$(current_field "$out" mode)"
  cur_norm="$(awk -F'@' '{printf "%s@%.2fHz", $1, $2}' <<<"$cur" 2>/dev/null || true)"
  # An entry now contains a space before the tick, so the list must travel as
  # an array; word-splitting an unquoted string would tear "1440@185Hz ✓" into
  # two menu rows.
  local -a marked
  mapfile -t marked < <(mark_current "$cur_norm" <<<"$modes")
  local sel
  sel="$(pick "$MON_ICON Resolution for $out" "${marked[@]}")" || return 1
  strip_tick "$(cut -f1 <<<"$sel")"
}

pick_scale() {
  local out="${1:-}"
  # The parentheses matter: `local presets="1" "1.25" ...` declares presets=1
  # and then tries to declare locals named "1.25" and "1.6", which are not
  # valid identifiers, so bash errors and only scale 1 was ever offered.
  local presets=("1" "1.25" "1.6" "2" "3" "4")
  local cur
  cur="$(current_field "$out" scale)"
  local -a marked
  mapfile -t marked < <(printf '%s\n' "${presets[@]}" | mark_current "$cur")
  local sel
  sel="$(pick "$SCALE_ICON Scale" "${marked[@]}")" || return 1
  strip_tick "$(cut -f1 <<<"$sel")"
}

pick_transform() {
  local out="${1:-}"
  local cur
  cur="$(current_field "$out" transform)"
  local labels=("Normal" "Rotate right (90°)" "Rotate 180°" "Rotate left (270°)")
  local opts=() i
  for i in 0 1 2 3; do
    if [[ "$i" == "$cur" ]]; then
      opts+=("$TF_ICON ${labels[$i]}$(printf '%b' "$TICK")\t$i")
    else
      opts+=("$TF_ICON ${labels[$i]}\t$i")
    fi
  done
  local sel
  sel="$(pick "$TF_ICON Orientation" "${opts[@]}")" || return 1
  echo "$sel" | cut -f2
}

pick_position() {
  local out="$1"
  local info w h others opts
  info="$(hyprctl monitors -j | jq -c --arg o "$out" '.[] | select(.name==$o)')"
  w="$(echo "$info" | jq -r '.width')"
  h="$(echo "$info" | jq -r '.height')"
  others="$(hyprctl monitors -j | jq -c --arg o "$out" '.[] | select(.name!=$o)')"

  opts=("$POS_ICON Auto\tauto")
  while read -r o; do
    [[ -n $o ]] || continue
    local nm x y ow oh
    nm="$(echo "$o" | jq -r '.name')"
    x="$(echo "$o" | jq -r '.x')"
    y="$(echo "$o" | jq -r '.y')"
    ow="$(echo "$o" | jq -r '.width')"
    oh="$(echo "$o" | jq -r '.height')"
    opts+=("$POS_ICON Left of $nm\t$((x - w))x$y")
    opts+=("$POS_ICON Right of $nm\t$((x + ow))x$y")
    opts+=("$POS_ICON Above $nm\t${x}x$((y - h))")
    opts+=("$POS_ICON Below $nm\t${x}x$((y + oh))")
  done < <(echo "$others" | jq -c '.') 

  local sel
  sel="$(pick "$POS_ICON Position for $out" "${opts[@]}")" || return 1
  echo "$sel" | cut -f2
}

cmd_monitor() {
  local what="${1:-}"
  [[ -n $what ]] || { echo "Usage: omarchy display pick monitor <mode|scale|position|transform>" >&2; exit 1; }
  local out
  out="$(pick_monitor)" || exit 0
  local val
  case "$what" in
    mode)     val="$(pick_mode "$out")" || exit 0 ;;
    scale)    val="$(pick_scale "$out")" || exit 0 ;;
    position) val="$(pick_position "$out")" || exit 0 ;;
    transform) val="$(pick_transform "$out")" || exit 0 ;;
    *) echo "Unknown monitor picker: $what" >&2; exit 1 ;;
  esac
  [[ -n $val ]] || exit 0
  "$BIN_DIR/omarchy-display-monitor" set "$out" "--$what" "$val"
}

cmd_terminal() {
  local terms=(alacritty kitty ghostty foot)
  local opts=()
  for t in "${terms[@]}"; do
    opts+=("$TERM_ICON $t")
  done
  local term
  term="$(pick "$TERM_ICON Terminal" "${opts[@]}")" || exit 0
  term="$(echo "$term" | cut -f2)"

  local sizes=(8 9 10 11 12 13 14 15 16 18 20)
  local sopts=()
  for s in "${sizes[@]}"; do
    sopts+=("$TERM_ICON ${s}pt")
  done
  local sz
  sz="$(pick "$TERM_ICON Font size for $term" "${sopts[@]}")" || exit 0
  sz="$(echo "$sz" | grep -oP '\d+')"
  [[ -n $sz ]] || exit 0
  "$BIN_DIR/omarchy-display-terminal" set "$term" "$sz"
}

case "${1:-}" in
  monitor) shift; cmd_monitor "$@" ;;
  terminal) cmd_terminal ;;
  ""|-h|--help) echo "Usage: omarchy display pick [monitor <mode|scale|position|transform>|terminal]" >&2 ;;
  *) echo "Unknown picker: $1" >&2; exit 1 ;;
esac
